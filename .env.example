# Local development only. Production builds read these values from client/vercel.json,
# so nothing here needs to be committed for the Vercel client to build correctly.
#
# Copy to client/.env when you need to point a local dev build somewhere other
# than the deployed API.
VITE_API_URL=http://localhost:5000/api

# Public Google OAuth web client ID. Safe to expose: it ships in the browser bundle.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
