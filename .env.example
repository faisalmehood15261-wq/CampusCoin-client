# Deployed API origin. Leave unset in production builds to fall back to
# https://campus-coin-omega.vercel.app/api; set it to http://localhost:5000/api for local dev.
VITE_API_URL=https://campus-coin-omega.vercel.app/api

# Public Google OAuth web client ID (safe to expose, it ships in the bundle).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
